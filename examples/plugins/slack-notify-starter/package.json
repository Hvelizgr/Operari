{
  "name": "@example/operari-slack-notify-starter",
  "version": "0.1.0",
  "description": "TypeScript starter for an Operari plugin — slack-notify done end-to-end (zod schema, TS source, tsc build, vitest tests).",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "operari": {
    "steps": [
      "./dist/index.js"
    ]
  },
  "peerDependencies": {
    "@operari/sdk": "^0.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "zod": "^3.24.0"
  }
}
