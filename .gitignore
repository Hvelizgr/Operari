# Documentation: ignore /docs internal scratch by default but keep ADRs and
# audit coverage tracked. Note: ignoring /docs/* (with the wildcard) instead
# of /docs lets git recurse into the directory so the negation patterns work.
/docs/*
!/docs/adr/
!/docs/audit-event-coverage.md
!/docs/rebranding-and-editor-audit.md
!/docs/OPS.md

