  "cards": [
    {
      "dot": "rose",
      "title": "What never happens",
      "items": [
        "The key is never written into the runbook, its versions or its YAML",
        "One workspace cannot decrypt another workspace's credential",
        "A step cannot call private or cloud-metadata addresses on a shared server"
      ]
    },
    {
      "dot": "emerald",
      "title": "What you can prove",
      "items": [
        "Every decrypt writes a secret.accessed event to the hash-chained log",
        "Credentials can only be stored when the server has ENCRYPTION_KEY"
      ]
    }
