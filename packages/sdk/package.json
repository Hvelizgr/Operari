{
  "name": "@operari/sdk",
  "version": "0.1.0",
  "description": "Official Node.js SDK for Operari — visual runbooks for engineers",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./steps": {
      "types": "./dist/steps/index.d.ts",
      "default": "./dist/steps/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "echo 'no tests yet'"
  },
  "keywords": [
    "operari",
    "runbook",
    "devops",
    "automation",
    "incident-response"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "zod": "^3.22.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "zod": "^3.22.0"
  }
}
