# ==============================================
# API Configuration
# ==============================================
# URL of the specific NanoFlow Backend API to connect to
NEXT_PUBLIC_API_URL=http://localhost:4001

# ==============================================
# Workflow Editor Settings
# ==============================================
# Minimum zoom level allowed in the canvas (0.1 = 10%)
NEXT_PUBLIC_EDITOR_MIN_ZOOM=0.1
# Maximum zoom level allowed in the canvas (2 = 200%)
NEXT_PUBLIC_EDITOR_MAX_ZOOM=2
