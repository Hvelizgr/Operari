# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:4000

# Editor Configuration
# Minimum zoom level for the workflow editor
NEXT_PUBLIC_EDITOR_MIN_ZOOM=0.1
# Maximum zoom level for the workflow editor
NEXT_PUBLIC_EDITOR_MAX_ZOOM=2

# Social login buttons — enable only after the matching backend
# GOOGLE_CLIENT_ID / GITHUB_CLIENT_ID is configured. Without the
# backend creds the button renders but the server returns 501.
NEXT_PUBLIC_OAUTH_GOOGLE=false
NEXT_PUBLIC_OAUTH_GITHUB=false

# Self-host single-tenant deployments that don't need auth at all
# can set this to "true" and the middleware will skip the redirect
# to /login for protected routes. Match backend OPERARI_ANONYMOUS_MODE.
NEXT_PUBLIC_OPERARI_ANONYMOUS_MODE=true

# Sentry (optional) — runtime SDK + source map upload at build time.
#
# Runtime (sent to the browser, baked into the bundle):
#   NEXT_PUBLIC_SENTRY_DSN     Project DSN. Without this, every Sentry
#                              call is a no-op and the SDK pays zero
#                              runtime cost. Self-hosted installs that
#                              do not want telemetry leave it empty.
#   NEXT_PUBLIC_OPERARI_ENV    Tag attached to events ("production",
#                              "staging", …). Defaults to "development".
#   NEXT_PUBLIC_OPERARI_VERSION  Release tag. Pair with the build-side
#                              upload below so stack traces resolve to
#                              the matching source maps.
#
# Build-time (only the build host needs these — never sent to clients):
#   SENTRY_AUTH_TOKEN          Org-level API token with `project:write`
#                              scope. Required for source map upload.
#                              Without it the build still succeeds but
#                              source maps are not uploaded — exceptions
#                              surface with minified frames.
#   SENTRY_ORG                 Sentry org slug (e.g. "operari").
#   SENTRY_PROJECT             Sentry project slug for the frontend.
#
# Self-host installs without Sentry: leave every var unset. The
# Sentry build plugin is configured to silently no-op when the auth
# token is missing, so `next build` keeps working with zero config.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_OPERARI_ENV=development
NEXT_PUBLIC_OPERARI_VERSION=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
