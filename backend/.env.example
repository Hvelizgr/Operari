# ==============================================
# Database Configuration
# ==============================================
# Connection string for PostgreSQL database
DATABASE_URL="postgresql://user:password@localhost:5432/nanoflow?schema=public"

# ==============================================
# Authentication (Internal)
# ==============================================
# Secret key for signing JWT tokens used for internal sessions
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
# Duration for which the JWT token is valid
JWT_EXPIRES_IN="7d"

# ==============================================
# Server Configuration
# ==============================================
# Port where the backend server will run
PORT=4001
# Environment mode (development/production)
NODE_ENV="development"
# Logging verbosity level (debug, info, warn, error)
LOG_LEVEL="info"

# ==============================================
# Email Services (SMTP)
# ==============================================
# SMTP server host for sending emails
SMTP_HOST="smtp.example.com"
# SMTP server port
SMTP_PORT=587
# SMTP user email
SMTP_USER="user@example.com"
# SMTP password or app-specific password
SMTP_PASS="your-smtp-password"

# ==============================================
# Third-Party Services
# ==============================================
# Secret key for Clerk Authentication (if enabled)
CLERK_SECRET_KEY=""

# ==============================================
# Infrastructure
# ==============================================
# Connection string for Redis (used for caching and rate limiting)
REDIS_URL="redis://localhost:6379"

# ==============================================
# Security
# ==============================================
# 32-byte hex key for encrypting sensitive data (like stored API keys) at rest
# Generate one with: openssl rand -hex 32
ENCRYPTION_KEY="replace-with-32-byte-hex-key"

# ==============================================
# n8n Integration (Optional)
# ==============================================
# Base URL of your n8n instance
N8N_BASE_URL="http://localhost:5678"
# API Key from n8n (Settings > API) - Required for Workflow Doctor
N8N_API_KEY=""
