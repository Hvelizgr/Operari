# Server Configuration
# The port the API server will listen on
PORT=4000

# Environment: 'development', 'production', or 'test'
NODE_ENV=development

# Frontend URL
# Used for CORS configuration
FRONTEND_URL=http://localhost:3000

# Database Configuration
# Prisma connection string for PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/nanoflow?schema=public"

# Authentication
# Secret key for signing JWT tokens. Must be at least 32 characters.
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
# JWT expiration duration (e.g., '1h', '7d')
JWT_EXPIRES_IN=7d

# AI Agent System
# At least one AI provider key is required for the chat/agent features
ANTHROPIC_API_KEY=sk-ant-your-key-here
# OPENAI_API_KEY=sk-your-key-here
# AI_MODEL_PROVIDER=anthropic
# AI_MODEL_NAME=claude-sonnet-4-6

# Secret encryption (required for OAuth tokens, future secret manager)
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NANORUN_SECRET_KEY=

# Runbook runner backend
# Where commands inside a runbook actually execute.
#   local  → spawn on the backend host (DEFAULT, self-host single-tenant only)
#   docker → ephemeral Docker container per execution (self-host multi-tenant)
#   fly    → Fly.io Machines / Firecracker microVM (cloud SaaS)
NANORUN_RUNNER=local
# FLY_API_TOKEN=
# FLY_APP_NAME=
# FLY_REGION=iad
# NANORUN_RUNNER_IMAGE=ghcr.io/nanorun/runner:latest

# OAuth / Connected Accounts (optional, for Sprint 3+)
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# OAUTH_REDIRECT_BASE_URL=http://localhost:4000
