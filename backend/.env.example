# Server Configuration
# The port the API server will listen on
PORT=4000

# Environment: 'development', 'production', or 'test'
NODE_ENV=development

# Frontend URL
# Used for CORS configuration
FRONTEND_URL=http://localhost:3000

# Database Configuration
# Prisma connection string for PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/nanorun?schema=public"

# Authentication
# Secret key for signing JWT tokens. Must be at least 32 characters.
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
# JWT expiration duration (e.g., '1h', '7d')
JWT_EXPIRES_IN=7d

# AI Agent System
# At least one AI provider key is required for the chat/agent features
ANTHROPIC_API_KEY=sk-ant-your-key-here
# OPENAI_API_KEY=sk-your-key-here
# AI_MODEL_PROVIDER=anthropic
# AI_MODEL_NAME=claude-sonnet-4-6

# Secret encryption (required for OAuth tokens, future secret manager)
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NANORUN_SECRET_KEY=

# Runbook runner backend
# Where commands inside a runbook actually execute.
#   local  → spawn on the backend host (DEFAULT, self-host single-tenant only)
#   docker → ephemeral Docker container per execution (self-host multi-tenant)
#   fly    → Fly.io Machines / Firecracker microVM (cloud SaaS)
NANORUN_RUNNER=local
# FLY_API_TOKEN=
# FLY_APP_NAME=
# FLY_REGION=iad
# NANORUN_RUNNER_IMAGE=ghcr.io/nanorun/runner:latest

# OAuth / Connected Accounts (optional, for Sprint 3+)
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# OAUTH_REDIRECT_BASE_URL=http://localhost:4000

# Social login (Google + GitHub). Buttons are hidden in the frontend
# when the corresponding NEXT_PUBLIC_OAUTH_* flag is unset, and the
# backend callback returns 501 when these credentials are missing.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# HttpOnly session cookie — leave unset to auto-detect request protocol.
# Set to "true" when running behind a TLS terminator that strips
# X-Forwarded-Proto so the cookie still gets its Secure flag.
# COOKIE_SECURE=

# Marketing contact form (optional)
# When RESEND_API_KEY is set, POST /api/contact forwards each submission
# to the Resend HTTP API. Without the key the route logs every
# submission structured instead (pick it up via log aggregation).
# Sign up at https://resend.com and verify the FROM_EMAIL domain before
# going live; otherwise Resend rejects the send.
# RESEND_API_KEY=re_your_key_here
# CONTACT_TO_EMAIL=hello@nanorun.dev
# CONTACT_FROM_EMAIL=contact@nanorun.dev

# Sentry error + performance observability (optional)
# Leave unset on self-host — the SDK is never initialized when
# SENTRY_DSN is absent, so no events leave your infra. In hosted mode
# set DSN to a project-scoped DSN; sample rate defaults to 10% so prod
# traffic doesn't blow your quota on day one.
# SENTRY_DSN=https://public@sentry.io/project-id
# SENTRY_ENV=production
# SENTRY_TRACES_SAMPLE_RATE=0.1
# APP_VERSION=git-sha-or-semver

# CSRF double-submit rollout
#   unset / "off" — middleware is a no-op (default for self-host)
#   "observe"     — logs mismatches via req.log.warn but lets them through
#   "true" / "enforce" — returns 403 on mismatch
# Flip to "observe" before enforcing; watch for csrf.mismatch log lines
# that don't match your frontend deploy, fix them, then flip to enforce.
# CSRF_ENFORCE=off
