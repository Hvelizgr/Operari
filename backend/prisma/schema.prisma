generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["tracing"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String       @id @default(uuid())
  email                   String       @unique
  passwordHash            String
  name                    String?
  role                    Role         @default(USER)
  tenantId                String
  emailVerified           Boolean      @default(false)
  emailVerifiedAt         DateTime?
  twoFactorEnabled        Boolean      @default(false)
  twoFactorSecret         String?
  twoFactorBackupCodes    Json         @default("[]")
  notificationPreferences Json? // User notification preferences
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  credentials             Credential[]
  executions              Execution[]
  tenant                  Tenant       @relation(fields: [tenantId], references: [id])
  workflows               Workflow[]
  auditLogs               AuditLog[]
  nodeComments            NodeComment[]
  workflowPermissions     WorkflowPermission[]
  workflowApprovals       WorkflowApproval[] @relation("Requester")
  reviewedApprovals       WorkflowApproval[] @relation("Reviewer")

  @@index([tenantId])
  @@index([email])
}

model Tenant {
  id             String          @id @default(uuid())
  name           String
  slug           String          @unique
  plan           Plan            @default(FREE)
  ssoConfig      Json? // SSO configuration (provider, clientId, etc.)
  ipWhitelist    Json? // IP whitelist configuration
  billingInfo    Json? // Stripe customer info and billing details
  themeConfig    Json? // White-labeling (logo, primary color, etc.)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  storageBuckets StorageBucket[]
  users          User[]
  workflows      Workflow[]
  auditLogs      AuditLog[]
  n8nInstances   N8nInstance[]
  globalVariables GlobalVariable[]

  @@index([slug])
}

model N8nInstance {
  id          String          @id @default(uuid())
  name        String
  url         String
  apiKey      String?
  status      String          @default("UNKNOWN")
  cpuUsage    Float           @default(0)
  ramUsage    Float           @default(0)
  version     String?
  tenantId    String
  environment EnvironmentType @default(DEVELOPMENT)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([environment])
}

enum EnvironmentType {
  DEVELOPMENT
  STAGING
  PRODUCTION
}

model GlobalVariable {
  id          String   @id @default(uuid())
  key         String
  value       String
  description String?
  tenantId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId])
}

model StorageBucket {
  id        String   @id @default(uuid())
  name      String
  data      Json     @default("{}")
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Workflow {
  id                   String                @id @default(uuid())
  name                 String
  description          String?
  nodes                Json?
  connections          Json?
  isActive             Boolean               @default(false)
  schedule             String?
  userId               String
  tenantId             String
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  executions           Execution[]
  tenant               Tenant                @relation(fields: [tenantId], references: [id])
  user                 User                  @relation(fields: [userId], references: [id])
  workflowConnections  WorkflowConnection[]
  workflowNodes        WorkflowNode[]
  systemEventListeners SystemEventListener[]
  permissions          WorkflowPermission[]
  approvals            WorkflowApproval[]
  requiresApproval     Boolean               @default(false)
  slaDefinition        SLADefinition?

  @@index([userId])
  @@index([tenantId])
  @@index([isActive])
}

model WorkflowNode {
  id                String               @id @default(uuid())
  workflowId        String
  type              String
  title             String
  positionX         Float
  positionY         Float
  config            Json?
  inputs            Json?
  outputs           Json?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  enabled           Boolean              @default(true)
  sourceConnections WorkflowConnection[] @relation("SourceNode")
  targetConnections WorkflowConnection[] @relation("TargetNode")
  workflow          Workflow             @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([type])
}

model WorkflowConnection {
  id           String       @id @default(uuid())
  workflowId   String
  sourceNodeId String
  sourcePort   Int?
  targetNodeId String
  targetPort   Int?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  sourceNode   WorkflowNode @relation("SourceNode", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode   WorkflowNode @relation("TargetNode", fields: [targetNodeId], references: [id], onDelete: Cascade)
  workflow     Workflow     @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([sourceNodeId])
  @@index([targetNodeId])
}

model Execution {
  id              String           @id @default(uuid())
  workflowId      String
  userId          String
  status          ExecutionStatus  @default(PENDING)
  trigger         TriggerType
  startedAt       DateTime         @default(now())
  completedAt     DateTime?
  duration        Int?
  error           String?
  metadata        Json?
  pausedAt        DateTime?
  resumeState     Json?
  user            User             @relation(fields: [userId], references: [id])
  workflow        Workflow         @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  executionErrors ExecutionError[]
  nodeLogs        NodeLog[]

  @@index([workflowId])
  @@index([userId])
  @@index([status])
  @@index([startedAt])
}

model NodeLog {
  id          String        @id @default(uuid())
  executionId String
  nodeId      String
  nodeName    String
  nodeType    String
  status      NodeLogStatus
  input       Json?
  output      Json?
  testResults Json?         // Results of automated tests: Array<{ id, name, passed, error? }>
  error       String?
  startedAt   DateTime      @default(now())
  completedAt DateTime?
  duration    Int?
  execution   Execution     @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@index([nodeId])
  @@index([status])
}

model ExecutionError {
  id          String        @id @default(uuid())
  executionId String
  nodeLogId   String?
  code        String
  message     String
  userMessage String
  severity    ErrorSeverity
  isRetryable Boolean       @default(false)
  retryCount  Int           @default(0)
  maxRetries  Int           @default(0)
  context     Json?
  stackTrace  String?
  cause       Json?
  createdAt   DateTime      @default(now())
  resolvedAt  DateTime?
  notifiedAt  DateTime?
  execution   Execution     @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@index([code])
  @@index([severity])
  @@index([createdAt])
}

model ErrorNotificationConfig {
  id          String           @id @default(uuid())
  tenantId    String
  name        String
  type        NotificationType
  webhookUrl  String?
  email       String?
  isActive    Boolean          @default(true)
  minSeverity ErrorSeverity    @default(HIGH)
  errorCodes  String[]         @default([])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([tenantId])
  @@index([isActive])
}

model ScheduledJob {
  id         String    @id @default(uuid())
  workflowId String    @unique
  cronExpr   String
  isActive   Boolean   @default(true)
  lastRunAt  DateTime?
  nextRunAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([isActive])
}

model NodeType {
  id          String   @id @default(uuid())
  type        String   @unique
  category    String
  icon        String
  color       String
  label       Json
  description Json?
  subtitle    Json?
  inputs      Json?    @default("[]")
  outputs     Json?    @default("[]")
  properties  Json?    @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([type])
}

model Credential {
  id        String   @id @default(uuid())
  name      String
  type      String
  data      String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Scope fields for access control
  environment      CredentialEnvironment @default(ALL)
  allowedWorkflows String[] // Array of workflow IDs that can use this credential
  allowedTags      String[] // Array of tags - workflows with these tags can use this credential
  description      String? // Optional description for the credential

  @@index([userId])
  @@index([type])
  @@index([environment])
}

model NodeComment {
  id         String   @id @default(uuid())
  workflowId String
  nodeId     String
  userId     String
  content    String
  parentId   String?  // For threaded replies
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id])
  parent     NodeComment? @relation("Thread", fields: [parentId], references: [id])
  replies    NodeComment[] @relation("Thread")

  @@index([workflowId, nodeId])
  @@index([userId])
}

model WorkflowPermission {
  id         String         @id @default(uuid())
  workflowId String
  userId     String
  level      AccessLevel
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  workflow   Workflow       @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workflowId, userId])
  @@index([workflowId])
  @@index([userId])
}

enum AccessLevel {
  READ
  WRITE
  ADMIN
}

enum CredentialEnvironment {
  DEVELOPMENT
  STAGING
  PRODUCTION
  ALL
}

enum Role {
  ADMIN
  USER
  VIEWER
}

enum Plan {
  FREE
  PRO
  GROWTH
  ENTERPRISE
}

enum ExecutionStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
  PAUSED
}

enum NodeLogStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  SKIPPED
}

enum TriggerType {
  MANUAL
  SCHEDULED
  WEBHOOK
  API
  SYSTEM_EVENT
}

// System Event Listeners - workflows that listen to internal events
model SystemEventListener {
  id          String          @id @default(uuid())
  workflowId  String
  eventType   SystemEventType
  eventFilter Json? // Optional filter criteria (e.g., { "alertName": "HighCPU" })
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  workflow    Workflow        @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, eventType])
  @@index([eventType])
  @@index([isActive])
}

enum SystemEventType {
  ALERT_TRIGGERED // When an alert condition fires
  WORKFLOW_COMPLETED // When another workflow completes successfully
  WORKFLOW_FAILED // When another workflow fails
  WORKFLOW_STARTED // When another workflow starts
  CREDENTIAL_EXPIRING // When a credential is about to expire
  CUSTOM // Custom user-defined events
}

enum ErrorSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NotificationType {
  WEBHOOK
  EMAIL
  SLACK
  TEAMS
}

model Metric {
  id         String   @id @default(uuid())
  tenantId   String
  nodeId     String?
  workflowId String?
  metricName String
  value      Float
  unit       String?
  tags       Json?
  timestamp  DateTime @default(now())

  @@index([timestamp])
  @@index([metricName])
  @@index([workflowId])
  @@index([nodeId])
  @@index([tenantId])
}

model AlertHistory {
  id        String          @id @default(uuid())
  tenantId  String
  type      SystemEventType
  severity  ErrorSeverity   @default(MEDIUM)
  title     String
  message   String
  metadata  Json?
  isRead    Boolean         @default(false)
  createdAt DateTime        @default(now())

  @@index([tenantId])
  @@index([createdAt])
  @@index([isRead])
}

model AuditLog {
  id           String   @id @default(uuid())
  tenantId     String
  userId       String
  action       String // e.g., "LOGIN", "CREDENTIAL_ACCESS", "WORKFLOW_UPDATE"
  resourceType String // e.g., "CREDENTIAL", "WORKFLOW"
  resourceId   String
  details      Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model Template {
  id          String   @id @default(uuid())
  name        Json // { en: string, es: string }
  description Json? // { en: string, es: string }
  nodes       Json?
  connections Json?
  category    String?
  icon        String?
  tags        String[] @default([])
  isPublic    Boolean  @default(false)
  userId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isPublic])
}

model AIFeedback {
  id         String   @id @default(uuid())
  messageId  String
  workflowId String
  feedback   String // 'positive' | 'negative'
  createdAt  DateTime @default(now())

  @@index([workflowId])
  @@index([feedback])
  @@index([createdAt])
}

model WorkflowVersion {
  id          String   @id @default(uuid())
  workflowId  String
  version     Int
  name        String?
  description String?
  nodes       Json?
  connections Json?
  commitSha   String?
  commitUrl   String?
  userId      String
  createdAt   DateTime @default(now())

  @@unique([workflowId, version])
  @@index([workflowId])
  @@index([userId])
  @@index([createdAt])
}

model GitHubIntegration {
  id           String   @id @default(uuid())
  tenantId     String   @unique
  accessToken  String
  refreshToken String?
  owner        String
  repo         String
  branch       String   @default("main")
  path         String   @default("workflows")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
}

model WorkflowApproval {
  id              String         @id @default(uuid())
  workflowId      String
  requesterId     String
  reviewerId      String?
  status          ApprovalStatus @default(PENDING)
  requestType     ApprovalType
  comment         String?
  reviewerComment String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  workflow        Workflow       @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  requester       User           @relation("Requester", fields: [requesterId], references: [id])
  reviewer        User?          @relation("Reviewer", fields: [reviewerId], references: [id])

  @@index([workflowId])
  @@index([requesterId])
  @@index([reviewerId])
  @@index([status])
}

model SLADefinition {
  id          String   @id @default(uuid())
  tenantId    String
  workflowId  String?  @unique // Can be global or per workflow
  name        String
  description String?
  maxDuration Int?     // in milliseconds
  minSuccessRate Float? // percentage (0-100)
  alertOnBreach Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  complianceHistory SLACompliance[]
  workflow    Workflow? @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model SLACompliance {
  id              String   @id @default(uuid())
  slaId           String
  executionId     String?
  status          SLAStatus
  breachType      String?  // 'DURATION' | 'ERROR' | 'THROUGHPUT'
  actualValue     Float
  thresholdValue  Float
  timestamp       DateTime @default(now())
  
  sla             SLADefinition @relation(fields: [slaId], references: [id], onDelete: Cascade)

  @@index([slaId])
  @@index([timestamp])
}

enum SLAStatus {
  COMPLIANT
  BREACHED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ApprovalType {
  ACTIVATION
  DEPLOYMENT
}
