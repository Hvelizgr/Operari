generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["tracing"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  /// Null for users created via OAuth only (Google / GitHub). A user
  /// can later set a password to enable the email/password login path
  /// in addition to their OAuth logins — identities are unioned via
  /// the OAuthAccount table, not by overwriting this field.
  passwordHash String?
  name         String?
  role         Role     @default(USER)
  tenantId     String
  /// True once the user has completed the email verification flow.
  /// OAuth users land here already true because the IdP (Google,
  /// GitHub) verified the inbox before handing over the token.
  /// Password-register users start false and see a banner until they
  /// click the link emailed at register time.
  emailVerified Boolean @default(false)
  /// TOTP (RFC 6238) two-factor. `mfaEnabled` flips true only after
  /// the user proves they have the secret by submitting a valid
  /// code during enroll. `mfaSecretCiphered` stores the shared
  /// secret encrypted at rest — a DB leak leaks ciphertext, not
  /// usable secrets.
  mfaEnabled        Boolean @default(false)
  mfaSecretCiphered String?
  /// Persistent account-lockout counters. Rate limiting at the
  /// edge catches burst attacks; these fields catch the patient
  /// slow attacker by carrying state across minutes + restarts.
  /// `failedLoginAttempts` is the rolling count inside the window
  /// (reset on success or window expiry). `lockedUntil` is set
  /// once the threshold is hit — checked on every login attempt
  /// and cleared on the next successful auth.
  failedLoginAttempts Int       @default(0)
  lastFailedLoginAt   DateTime?
  lockedUntil         DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  runbooks         Runbook[]
  executions        Execution[]
  conversations     Conversation[]
  connectedAccounts ConnectedAccount[]
  roleAssignments   RoleAssignment[]
  oauthAccounts     OAuthAccount[]
  passwordResets    PasswordResetToken[]
  emailVerifications EmailVerificationToken[]
  mfaBackupCodes    MfaBackupCode[]
  runbookVersions   RunbookVersion[]
  keyRotationJobs   KeyRotationJob[]

  @@index([tenantId])
  @@index([email])
}

/// Federated identity linked to a User. One User can have many
/// OAuthAccounts (Google + GitHub + ...), plus optionally a
/// passwordHash — the login paths all resolve back to the same
/// authenticated user. Rows are unique per (provider, providerId)
/// which is the natural key from the IDP side.
model OAuthAccount {
  id         String   @id @default(uuid())
  provider   String
  providerId String
  userId     String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
}

/// Single-use MFA backup code. Generated ten at a time when the user
/// enrolls in TOTP; shown ONCE (download/copy) and stored SHA-256
/// hashed at rest. Each code doubles as a phone-lost recovery vector:
/// the login handler accepts a backup code in the `totpCode` field
/// when no TOTP matches, consumes it on success (sets `usedAt`). A
/// stolen DB dump cannot mint usable codes.
model MfaBackupCode {
  id        String    @id @default(uuid())
  codeHash  String    @unique
  userId    String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Email verification token. Same SHA-256-at-rest pattern as
/// PasswordResetToken — a DB leak cannot mint a working link. TTL is
/// longer (7 days vs 30 min) because verification is lower-urgency
/// than reset and users routinely click the link hours after
/// registering. Single-use enforced via `usedAt`.
model EmailVerificationToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Outstanding team invites for a tenant. The inviter hands out a
/// single-use link; the recipient clicks it and joins the inviter's
/// tenant instead of creating a fresh one. Same SHA-256-at-rest
/// contract as the reset / verification tokens — a DB leak cannot
/// mint a working link.
///
/// Three terminal states besides "pending":
///   - `acceptedAt` set: the row is consumed. `acceptedByUserId`
///     points at the brand-new User so audit can trace joins.
///   - `revokedAt` set: admin clicked Revoke before acceptance.
///   - `expiresAt` in the past: natural TTL (7 days).
///
/// Only ONE pending invite per (tenantId, email) — the route layer
/// revokes prior pending rows before creating a new one (Prisma has
/// no partial unique index so we enforce this in code).
model TenantInvite {
  id               String    @id @default(uuid())
  tokenHash        String    @unique
  email            String
  tenantId         String
  role             Role      @default(USER)
  invitedByUserId  String
  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedByUserId String?
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([email])
  @@index([expiresAt])
}

/// Short-lived password reset token. We store only the SHA-256 of
/// the token so a database read cannot mint a working reset link —
/// only the bearer of the raw string can consume it. `usedAt` pins
/// single-use: once consumed the row stays (audit trail) but is
/// treated as invalid on subsequent lookups. Expired rows are
/// swept lazily; no background job required.
model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  plan      Plan     @default(FREE)
  /// Tenant-wide "everyone must have TOTP enrolled" toggle. When
  /// true, users without `User.mfaEnabled` receive a login response
  /// with `mfaEnrollmentRequired: true` and the frontend forces them
  /// into the enrollment page. Admin-only write; refuses to enable
  /// when the calling admin has not themselves enrolled (can't
  /// lock the tenant out of its own admin).
  mfaRequired Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// WorkOS organization id (`org_...`). Set when the tenant is
  /// linked to a WorkOS organization for SSO. WorkOSAuthProvider
  /// uses this to map an incoming WorkOS-issued JWT to a NanoRun
  /// tenant. Null for self-host tenants and cloud tenants that
  /// have not configured SSO yet.
  workosOrganizationId String? @unique

  /// Stripe customer id (`cus_...`). Set when the tenant is linked
  /// to a Stripe customer for billing. StripeBillingMeter reads
  /// this on every meter event so calls can be attributed to the
  /// right billing-side customer. Null for self-host tenants.
  stripeCustomerId String? @unique
  /// Stripe subscription id (`sub_...`). Present when the tenant is
  /// on a paid plan. Written by the /billing/webhook handler on
  /// checkout.session.completed and cleared on
  /// customer.subscription.deleted.
  stripeSubscriptionId String? @unique
  /// Current billing status. Mirrors Stripe's subscription.status —
  /// `active`, `past_due`, `canceled`, `trialing`. Null for free
  /// tenants. Surfaced by the settings banner for dunning warnings.
  planStatus String?
  /// End of the current billing period (Stripe's `current_period_end`).
  /// Used to show the user when the next renewal hits.
  planCurrentPeriodEnd DateTime?

  /// Workspace-wide compute defaults. Filled by the trigger path
  /// when neither the request payload nor the runbook spec
  /// supplies an explicit value. Schema is freeform JSONB but the
  /// service layer reads it through a zod parser:
  ///   {
  ///     "machine": "small-1x" | "micro" | ...,
  ///     "ttlSeconds": number | null,
  ///     "retryCount": number,
  ///     "dryRun": boolean
  ///   }
  /// Null = use the engine fallbacks (small-1x, no TTL, 0 retries,
  /// dry-run off). Admin-only writes via PATCH /api/tenants/me.
  computeDefaults Json?

  users             User[]
  runbooks         Runbook[]
  storageBuckets    StorageBucket[]
  conversations     Conversation[]
  agents            Agent[]
  connectedAccounts ConnectedAccount[]
  apiKeys           ApiKey[]
  webhooks          Webhook[]
  customRoles       CustomRole[]
  eventAgents       EventAgent[]
  monitors          Monitor[]
  invites           TenantInvite[]
  executions        Execution[]
  nodeLogs          NodeLog[]
  executionErrors   ExecutionError[]
  webhookEvents     WebhookEvent[]
  runbookVersions   RunbookVersion[]
  billingEvents     BillingEvent[]
  nodeTypes         NodeType[]
  alertChannels     TenantAlertChannel[]
  waitpoints        Waitpoint[]

  @@index([slug])
}

/// Tenant-wide alert channel defaults for monitors. When a Monitor
/// has no per-row alertWebhookUrl / alertEmail, the resolver falls
/// back to the tenant's first active TenantAlertChannel row. Multiple
/// rows per tenant are allowed so admins can stage a replacement
/// (isActive=false) before flipping it live.
model TenantAlertChannel {
  id         String   @id @default(uuid())
  tenantId   String
  webhookUrl String?
  email      String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive])
}

model StorageBucket {
  id        String   @id @default(uuid())
  name      String
  data      Json     @default("{}")
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Runbook {
  id          String   @id @default(uuid())
  // NanoRun: slug is used by the SDK/CLI to reference runbooks (e.g. "deploy-frontend")
  slug        String?
  name        String
  description String?
  // NanoRun: category for organizing runbooks (e.g. "deploy", "migration", "incident")
  category    String?
  // DEPRECATED: These JSON fields are kept for backward compatibility during migration
  // They will be removed in a future version once all data is migrated
  nodes       Json?
  connections Json?
  /// Typed input declarations collected from the user before a run
  /// (Rundeck-style job options). When non-empty, the Run dialog renders
  /// a form instead of the raw JSON input box. Values flow into
  /// `ExecutorContext.variables` so `{{vars.foo}}` templates resolve.
  inputs      Json?    @default("[]")
  isActive    Boolean  @default(false)
  schedule    String?
  userId      String
  tenantId    String
  /// When a run of this Runbook ends with status=FAILED, the engine
  /// dispatches a child run of `onErrorRunbookId` with the failure
  /// payload as input. Designed for "if deploy fails, run rollback"
  /// style meta-automation. SetNull on delete so deleting the handler
  /// does not cascade into deleting the parent runbook.
  onErrorRunbookId String?
  onErrorRunbook   Runbook?  @relation("RunbookErrorHandler", fields: [onErrorRunbookId], references: [id], onDelete: SetNull)
  errorHandlerFor  Runbook[] @relation("RunbookErrorHandler")
  /// Step-id breakpoints. When the engine is about to execute a node
  /// whose id appears in this list, it persists resume state and pauses
  /// (same mechanism as the approval/Suspend halt). Operators step over
  /// or continue from the editor. Default empty array — breakpoints are
  /// set per-node via the canvas, never required for normal runs.
  breakpoints String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user                User                @relation(fields: [userId], references: [id])
  tenant              Tenant              @relation(fields: [tenantId], references: [id])
  executions          Execution[]
  versions            RunbookVersion[]
  // New normalized relationships
  steps           RunbookStep[]
  stepConnections RunbookConnection[]
  webhooks            Webhook[]
  approvals           Approval[]
  eventAgents         EventAgent[]
  scheduledJob        ScheduledJob?
  monitors            Monitor[]

  @@unique([tenantId, slug])
  @@index([userId])
  @@index([tenantId])
  @@index([isActive])
  @@index([onErrorRunbookId])
}

/// Immutable snapshot of a Runbook definition at save time.
///
/// Every save on Runbook produces a new row here (monotonic `version`
/// per runbookId). The engine reads from the snapshot — never from the
/// mutable Runbook columns — for any Execution that carries a
/// runbookVersionId. A historical run therefore always replays against
/// the exact bytes it was dispatched with.
///
/// Kept separate from the `Runbook` row so the working copy can keep
/// evolving (drafts, autosaves) without polluting the version ledger.
/// `snapshot` is a JSON blob with the definition (nodes, connections,
/// inputs, metadata) plus the runbook's metadata at save time — the
/// engine treats it as the source of truth for THIS run.
model RunbookVersion {
  id              String   @id @default(uuid())
  runbookId       String
  /// Denormalized tenant scope matches Execution's pattern — the
  /// tenant guard middleware expects tenantId on any table it cares
  /// about, and historical queries filter by tenant before version.
  tenantId        String
  version         Int
  snapshot        Json
  createdByUserId String?
  createdAt       DateTime @default(now())

  runbook    Runbook     @relation(fields: [runbookId], references: [id], onDelete: Cascade)
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy  User?       @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  executions Execution[]

  @@unique([runbookId, version])
  @@index([tenantId, createdAt])
}

// Normalized RunbookStep model.
model RunbookStep {
  id         String   @id @default(uuid())
  runbookId String
  type       String
  title      String
  positionX  Float
  positionY  Float
  enabled    Boolean  @default(true)
  config     Json? // Node-specific configuration (HTTP settings, email templates, etc.)
  inputs     Json? // Array of input ports
  outputs    Json? // Array of output ports
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  runbook          Runbook             @relation(fields: [runbookId], references: [id], onDelete: Cascade)
  sourceConnections RunbookConnection[] @relation("SourceNode")
  targetConnections RunbookConnection[] @relation("TargetNode")

  @@index([runbookId])
  @@index([type])
}

// Normalized RunbookConnection model.
model RunbookConnection {
  id           String   @id @default(uuid())
  runbookId   String
  sourceNodeId String
  sourcePort   Int? // Index of the source port
  targetNodeId String
  targetPort   Int? // Index of the target port
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  runbook   Runbook     @relation(fields: [runbookId], references: [id], onDelete: Cascade)
  sourceNode RunbookStep @relation("SourceNode", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode RunbookStep @relation("TargetNode", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@index([runbookId])
  @@index([sourceNodeId])
  @@index([targetNodeId])
}

model Execution {
  id          String          @id @default(uuid())
  runbookId  String
  /// Denormalized tenant scope. Joined-through scoping via Runbook
  /// was fragile — any query that forgot the join leaked data across
  /// tenants. Always populated at create-time from the Runbook, and
  /// a Prisma middleware rejects queries to this table that don't
  /// filter by tenantId.
  tenantId    String
  userId      String
  status      ExecutionStatus @default(PENDING)
  trigger     TriggerType
  startedAt   DateTime        @default(now())
  completedAt DateTime?
  duration    Int?
  error       String?
  pausedAt    DateTime?
  resumeState Json?
  metadata    Json?
  /// Free-form tags pushed at runtime (trigger.dev parity). Steps
  /// inside a run call `runs.tag(['env:prod', 'user:42'])` to attach
  /// arbitrary slugs; the runs list filters by `tags && ARRAY['x']`
  /// over a GIN index so arbitrary axes (env, customer, incident id,
  /// caller) become cheap slicing. Capped at 16 tags per run by the
  /// API to keep payload + GIN entries bounded.
  tags        String[]   @default([])
  /// TTL — absolute time at which the run is abandoned if the
  /// engine has not picked it up. Trigger.dev parity for the "only
  /// run this if it's still relevant" use case (e.g. webhook with
  /// 30s TTL: if the queue is backlogged the work is dropped, not
  /// run with stale input). Null = no TTL.
  expiresAt   DateTime?
  /// Idempotency key — when set, repeated triggers with the same
  /// (tenantId, runbookId, idempotencyKey) return the original
  /// Execution row instead of spawning a duplicate. Trigger.dev
  /// parity. Unique scope is enforced by a partial index that
  /// excludes null keys, so legacy rows do not collide. The SDK
  /// helper `idempotencyKeys.create(...)` produces hashed keys
  /// scoped per-run / per-attempt / per-tenant.
  idempotencyKey String?

  /// Dry-run mode: step executors log what they WOULD do (commands,
  /// requests, notifications) without executing any side effect.
  /// Approval gates auto-approve; notify / http / shell / ssh only
  /// emit log lines. Sub-runs (via the `runbook` step) inherit this
  /// flag so a whole tree stays consistent. The UI badges dry-run
  /// executions distinctly so operators can't mistake a dry-run
  /// success for an actual deploy.
  dryRun      Boolean         @default(false)

  /// When this Execution was spawned by a `runbook` step inside another
  /// run, we link it back so the UI can render a parent/child trace and
  /// the engine can detect cycles (same runbookId appearing twice in an
  /// ancestor chain = bail out). Null for top-level runs.
  parentExecutionId String?
  parent            Execution?  @relation("ExecutionHierarchy", fields: [parentExecutionId], references: [id], onDelete: SetNull)
  children          Execution[] @relation("ExecutionHierarchy")

  /// Frozen definition this run was dispatched against. Null for
  /// pre-A1 historical rows (backfill is deliberately lossy — we
  /// cannot truthfully claim which version they saw). New executions
  /// always populate this.
  runbookVersionId String?

  runbook        Runbook          @relation(fields: [runbookId], references: [id], onDelete: Cascade)
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id])
  runbookVersion  RunbookVersion?  @relation(fields: [runbookVersionId], references: [id], onDelete: SetNull)
  nodeLogs        NodeLog[]
  executionErrors ExecutionError[]
  waitpoints      Waitpoint[]

  @@index([runbookId])
  @@index([userId])
  @@index([status])
  @@index([startedAt])
  @@index([parentExecutionId])
  @@index([runbookVersionId])
  @@index([tenantId, status, startedAt(sort: Desc)])
}

model NodeLog {
  id          String        @id @default(uuid())
  executionId String
  /// Denormalized from Execution. Lets per-tenant error dashboards
  /// and agent tools scan step logs without joining to Execution on
  /// every query.
  tenantId    String
  nodeId      String
  nodeName    String
  nodeType    String
  status      NodeLogStatus
  input       Json?
  output      Json?
  error       String?
  startedAt   DateTime      @default(now())
  completedAt DateTime?
  duration    Int?

  execution Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@index([nodeId])
  @@index([status])
  @@index([tenantId, executionId])
}

model ExecutionError {
  id          String        @id @default(uuid())
  executionId String
  /// Denormalized from Execution. Per-tenant error dashboards filter
  /// by tenant + severity + time — the composite index below covers
  /// that path without a join.
  tenantId    String
  nodeLogId   String?
  code        String
  message     String
  userMessage String
  severity    ErrorSeverity
  isRetryable Boolean       @default(false)
  retryCount  Int           @default(0)
  maxRetries  Int           @default(0)
  context     Json?
  stackTrace  String?
  cause       Json?
  createdAt   DateTime      @default(now())
  resolvedAt  DateTime?
  notifiedAt  DateTime?

  execution Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@index([code])
  @@index([severity])
  @@index([createdAt])
  @@index([tenantId, severity, createdAt(sort: Desc)])
}

model ErrorNotificationConfig {
  id          String           @id @default(uuid())
  tenantId    String
  name        String
  type        NotificationType
  webhookUrl  String?
  email       String?
  isActive    Boolean          @default(true)
  minSeverity ErrorSeverity    @default(HIGH)
  errorCodes  String[]         @default([])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([tenantId])
  @@index([isActive])
}

model ScheduledJob {
  id         String    @id @default(uuid())
  runbookId String    @unique
  cronExpr   String
  isActive   Boolean   @default(true)
  lastRunAt  DateTime?
  nextRunAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  runbook Runbook @relation(fields: [runbookId], references: [id], onDelete: Cascade)

  @@index([isActive])
}

enum Role {
  ADMIN
  USER
  VIEWER
}

enum Plan {
  FREE
  /// Hosted tier aimed at small ops teams. $19/user/mo, includes
  /// managed Postgres, SSO (Google/Microsoft), 14-day run retention.
  TEAM
  /// Platform-eng tier. $49/user/mo, adds SAML+SCIM, audit export,
  /// 1-year retention, 99.9% SLA.
  BUSINESS
  ENTERPRISE
  /// Deprecated legacy tier — kept so existing migrations and any
  /// stray production rows still resolve. Do not assign to new
  /// tenants; new code paths should use TEAM/BUSINESS instead.
  PRO
}

enum ExecutionStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
  PAUSED
}

enum NodeLogStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  SKIPPED
}

enum TriggerType {
  MANUAL
  SCHEDULED
  WEBHOOK
  API
  /// Spawned by a `runbook` step inside another execution. The parent
  /// Execution.id lives on `parentExecutionId`, which the UI uses to
  /// render the sub-run tree.
  RUNBOOK
  /// Spawned automatically because a parent run hit status=FAILED and
  /// the parent runbook declared `onErrorRunbookId`. Distinct from
  /// RUNBOOK so the engine can refuse to chain error triggers (an
  /// ERROR-triggered run that itself FAILs does NOT trigger its own
  /// onErrorRunbookId — otherwise a misconfigured handler loops).
  ERROR
}

enum ErrorSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NotificationType {
  WEBHOOK
  EMAIL
  SLACK
  TEAMS
}

model NodeType {
  id       String @id @default(uuid())
  /// Step type. Globally unique only when paired with tenantId — two
  /// tenants can independently install a plugin that claims the same
  /// type without colliding. The composite uniqueness is enforced
  /// below via @@unique([type, tenantId]). The single-column index
  /// stays so the legacy `where: { type }` upsert in the seed still
  /// finds globals (Postgres allows multiple NULLs in a unique
  /// composite, so the seed's tenantId=NULL rows remain at-most-one
  /// per type).
  type     String
  category String // e.g. "triggers"

  /// Optional tenant scope. NULL means "core global type" — visible
  /// to every tenant (the existing seed rows). Non-NULL rows are
  /// tenant-owned custom node types installed via the SDK plugin
  /// path; the /api/node-types endpoint unions globals + the caller's
  /// tenant-owned rows. Cascade on tenant delete so a tenant purge
  /// doesn't leave orphan node-type rows.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Visuals
  icon  String // Lucide icon name
  color String // Tailwind class or hex

  // I18n
  label       Json // { "en": "Webhook", "es": "Webhook" }
  description Json? // { "en": "...", "es": "..." }
  subtitle    Json? // Extra info shown in search

  // Logic & Ports
  // e.g. [{ name: "main", type: "main", label: "Input" }, { name: "ai_tool", type: "ai_tool" }]
  inputs  Json? @default("[]")
  outputs Json? @default("[]")

  // Configuration UI Definition (Future proofing)
  // Defines fields: name, type (string/select), options, etc.
  properties Json? @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, tenantId])
  @@index([tenantId])
  @@index([category])
  @@index([type])
}

// ============================================
// AI Agent System Models
// ============================================

model Conversation {
  id        String             @id @default(uuid())
  userId    String
  tenantId  String
  title     String?
  status    ConversationStatus @default(ACTIVE)
  metadata  Json?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user     User          @relation(fields: [userId], references: [id])
  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  messages ChatMessage[]
  agents   Agent[]

  @@index([userId])
  @@index([tenantId])
}

model ChatMessage {
  id             String      @id @default(uuid())
  conversationId String
  role           MessageRole
  content        String
  toolCalls      Json?
  metadata       Json?
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
}

/// DEPRECATED (pre-pivot legacy). Schema-only placeholder from the
/// NanoFlow era — never wired to a service or executor. Kept to avoid
/// a destructive migration. The Agents surface in NanoRun lives on
/// EventAgent / EventAgentExecution below.
model Agent {
  id             String      @id @default(uuid())
  conversationId String
  tenantId       String
  name           String
  description    String?
  status         AgentStatus @default(IDLE)
  agentType      String
  config         Json?
  mcpServers     String[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  conversation Conversation     @relation(fields: [conversationId], references: [id])
  tenant       Tenant           @relation(fields: [tenantId], references: [id])
  executions   AgentExecution[]

  @@index([conversationId])
  @@index([tenantId])
  @@index([status])
}

/// DEPRECATED — see note on Agent.
model AgentExecution {
  id          String          @id @default(uuid())
  agentId     String
  status      ExecutionStatus @default(PENDING)
  trigger     TriggerType
  input       Json?
  output      Json?
  error       String?
  startedAt   DateTime        @default(now())
  completedAt DateTime?
  duration    Int?

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([status])
  @@index([startedAt])
}

/// NanoRun Event Agent — a declarative listener that turns inbound
/// webhook events into runbook triggers. The matcher is either a
/// jsonpath rule (cheap, deterministic) or an LLM rule (slower, used
/// only when the source payload is unstructured). Variables for the
/// triggered runbook are extracted via varMapping (key → jsonpath).
///
/// Lifecycle:
///   1. Webhook arrives at /webhook/:token/:event
///   2. Receiver looks up EventAgent[] WHERE webhookId = X (or null source-match)
///   3. For each agent, run match(payload) → { matched, reason, vars }
///   4. If matched + rate limit OK, trigger targetRunbook with vars
///   5. Persist EventAgentExecution with the outcome
model EventAgent {
  id               String    @id @default(uuid())
  tenantId         String
  name             String
  description      String?
  source           String // "sentry" | "datadog" | "github" | "custom"
  webhookId        String? // optional FK to Webhook the events come from
  matcherType      String // "jsonpath" | "llm" | "always"
  matcherConfig    Json // shape depends on matcherType
  targetRunbookId  String
  varMapping       Json // { "key": "$.json.path", ... }
  isEnabled        Boolean   @default(true)
  rateLimitPerHour Int       @default(10)
  triggerCount     Int       @default(0)
  matchCount       Int       @default(0)
  lastTriggeredAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  targetRunbook Runbook               @relation(fields: [targetRunbookId], references: [id], onDelete: Cascade)
  webhook       Webhook?              @relation(fields: [webhookId], references: [id], onDelete: SetNull)
  executions    EventAgentExecution[]

  @@index([tenantId])
  @@index([webhookId])
  @@index([source])
  @@index([targetRunbookId])
}

/// NanoRun Monitor — a watchdog over a runbook's health. Polled every
/// minute by the SchedulerService. Three check types in v0.1:
///   - last_success_within: must have a SUCCESS run in the last N minutes
///   - no_run_within:       must have ANY run in the last N minutes
///   - failure_rate_above:  fail if >X% of runs in last N minutes failed
/// When a check fails, status flips to FIRING and a MonitorEvent row
/// is appended. Recovery flips it back to OK with another event.
model Monitor {
  id          String    @id @default(uuid())
  tenantId    String
  runbookId  String
  name        String
  description String?
  checkType   String // "last_success_within" | "no_run_within" | "failure_rate_above"
  checkConfig Json // type-specific: { windowMinutes: 60, threshold?: 0.2 }
  isEnabled   Boolean   @default(true)
  status      String    @default("UNKNOWN") // "OK" | "FIRING" | "UNKNOWN"
  lastCheckAt DateTime?
  lastFiredAt DateTime?
  lastReason  String?
  /// Slack incoming-webhook URL. When set and the monitor flips to
  /// FIRING, MonitorAlertService POSTs a minimal payload here. Null
  /// disables the channel; per-monitor config is the v1 surface and
  /// richer tenant-wide routing can layer on later.
  alertWebhookUrl String?
  /// Recipient email address for FIRING alerts. Delivered via the
  /// existing SMTP/Resend sendEmail helper; log-only if neither is
  /// configured.
  alertEmail      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runbook Runbook        @relation(fields: [runbookId], references: [id], onDelete: Cascade)
  events   MonitorEvent[]

  @@index([tenantId])
  @@index([runbookId])
  @@index([status])
}

/// Status transitions of a monitor — append-only.
model MonitorEvent {
  id        String   @id @default(uuid())
  monitorId String
  status    String // "OK" | "FIRING"
  reason    String?
  createdAt DateTime @default(now())

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId])
  @@index([createdAt])
}

/// One row per inbound event evaluated against an EventAgent — the
/// audit trail for "why did this run start" or "why didn't it".
model EventAgentExecution {
  id             String   @id @default(uuid())
  agentId        String
  payload        Json
  matched        Boolean
  reason         String?
  triggeredRunId String?
  createdAt      DateTime @default(now())

  agent EventAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([createdAt])
  @@index([matched])
}

model ConnectedAccount {
  id           String    @id @default(uuid())
  userId       String
  tenantId     String
  provider     String
  displayName  String?
  accessToken  String
  refreshToken String?
  tokenExpiry  DateTime?
  scopes       String[]
  metadata     Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([userId, provider, displayName])
  @@index([userId])
  @@index([tenantId])
  @@index([provider])
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
  COMPLETED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum AgentStatus {
  IDLE
  RUNNING
  PAUSED
  FAILED
  COMPLETED
}

// ============================================
// NanoRun Models (Runbook Automation)
// ============================================

/// API keys used by SDK and CLI to authenticate with the NanoRun API.
/// The plain key is shown only once on creation; we store a bcrypt hash.
model ApiKey {
  id         String    @id @default(uuid())
  tenantId   String
  name       String // Human-readable label
  keyHash    String    @unique // bcrypt hash of the full key
  prefix     String // First 12 chars (e.g. "nr_live_abc...") for display
  scopes     String[] // ["runbooks:trigger", "runbooks:read", "runs:read", ...]
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdBy  String? // User who created the key
  createdAt  DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([prefix])
}

/// Inbound webhook receivers. Each webhook is bound to a runbook and a token.
/// External services (Sentry, Datadog, GitHub, custom) POST here to trigger runs.
model Webhook {
  id              String    @id @default(uuid())
  tenantId        String
  runbookId      String // Workflow/Runbook this webhook triggers
  source          String // "sentry" | "datadog" | "github" | "custom"
  token           String    @unique // URL token: /api/webhooks/:token/:event
  secret          String? // Optional HMAC secret for signature validation
  isActive        Boolean   @default(true)
  triggerCount    Int       @default(0)
  lastTriggeredAt DateTime?
  createdAt       DateTime  @default(now())

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runbook    Runbook      @relation(fields: [runbookId], references: [id], onDelete: Cascade)
  eventAgents EventAgent[]
  receipts    WebhookReceipt[]

  @@index([tenantId])
  @@index([token])
  @@index([runbookId])
}

/// Debug trail for inbound webhooks. One row per POST to
/// /webhook/:token — captures the raw headers, body, and outcome
/// (accepted → runbook triggered, rejected → signature mismatch,
/// error → executor failure). Retained rolling-50 per webhook so
/// tenants with noisy sources don't grow the table unbounded.
///
/// Drives the "Webhook debugger" panel in TriggersPanel — an SRE
/// who can see the actual payload the external service sent can
/// fix their mapping without emailing support.
model WebhookReceipt {
  id           String   @id @default(uuid())
  webhookId    String
  tenantId     String
  /// "accepted" | "rejected_signature" | "rejected_inactive" | "error"
  /// | "error_exhausted"  (retry cap reached)
  /// | "replayed_success" (WebhookRetryWorker picked it up and it
  /// landed successfully on a subsequent attempt)
  status       String
  statusCode   Int
  /// Short reason for non-accepted statuses (e.g. "HMAC mismatch").
  /// Null on accepted receipts.
  reason       String?
  /// Captured request headers. Sensitive headers (Authorization,
  /// Cookie) are scrubbed at persistence time.
  headers      Json
  /// Parsed JSON body, or { _raw: "<string>" } for non-JSON payloads.
  body         Json
  /// Inbound source IP (X-Forwarded-For aware). Useful when
  /// lock-listing a bad sender.
  sourceIp     String?
  /// When the receipt triggered a runbook execution, the id of
  /// that Execution. Null when the call was rejected before it
  /// reached the executor. Enables "show me the run this webhook
  /// spawned" in the UI.
  executionId  String?
  /// Background retry bookkeeping. WebhookRetryWorker polls rows
  /// where status='error' + nextRetryAt<=now and calls execute()
  /// again. retryAttempts caps at a hard ceiling after which the
  /// row flips to 'error_exhausted' (terminal, operator-only).
  retryAttempts Int       @default(0)
  nextRetryAt   DateTime?
  receivedAt   DateTime @default(now())

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, receivedAt])
  @@index([tenantId])
  @@index([status, nextRetryAt])
}

/// Human approval gates. When a runbook reaches an approval node, it pauses
/// and creates an Approval record. The run resumes once approved/rejected.
model Approval {
  id          String         @id @default(uuid())
  runbookId  String
  executionId String // The Execution/Run this approval belongs to
  stepId      String // The node id in the workflow that requested approval
  status      ApprovalStatus @default(PENDING)
  message     String? // Message shown to approvers
  requestedBy String?
  approvedBy  String?
  approvedAt  DateTime?
  comment     String?
  createdAt   DateTime       @default(now())

  runbook Runbook @relation(fields: [runbookId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@index([runbookId])
  @@index([status])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

/// Per-tenant custom role with a flat list of permission strings.
///
/// Permissions follow the same `resource:verb` shape used by API key
/// scopes (e.g. `runbook:read`, `audit:read`, `*`). Wildcards work at
/// the resource level: `runbook:*` grants every verb on `runbook`.
///
/// Built-in roles created automatically when a tenant is provisioned
/// have `isSystem = true` and cannot be deleted via the public API.
/// The model is named `CustomRole` (rather than `Role`) to avoid a
/// clash with the existing `Role` enum on `User`, which is preserved
/// for backwards compatibility — see PermissionService for the
/// fallback path.
model CustomRole {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  permissions String[]
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignments RoleAssignment[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

/// Many-to-many: which custom roles a user holds. A user with no
/// assignments still gets effective permissions via PermissionService's
/// fallback to the legacy User.role enum.
model RoleAssignment {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  grantedBy String?
  grantedAt DateTime @default(now())

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role CustomRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

/// Append-only, hash-chained audit log.
///
/// Each row references the previous row's hash via `prevHash`. `hash` is
/// computed as sha256(prevHash || canonicalJson(payload)). Tampering with
/// any historical row breaks the chain at every later row, which the
/// `AuditService.verifyChain()` method detects.
///
/// UPDATE and DELETE on this table are blocked by a Postgres trigger
/// installed in the migration `add_audit_event` — even a tenant admin with
/// direct DB access cannot rewrite history without dropping the trigger,
/// which itself shows up in Postgres logs.
model AuditEvent {
  /// Monotonically-increasing sequence per tenant. Used as the chain
  /// position so we can detect gaps.
  seq       BigInt   @default(autoincrement())
  id        String   @id @default(uuid())
  tenantId  String
  /// Event type, e.g. "run.started", "run.completed", "approval.granted",
  /// "secret.accessed", "runbook.updated", "apikey.used".
  type      String
  /// Optional actor — user ID, API key ID, or "system".
  actorId   String?
  actorType String?
  /// Optional resource the event is about (runbook ID, run ID, …).
  resource  String?
  /// Arbitrary structured payload. Encoded as canonical JSON for hashing.
  payload   Json
  /// Hex sha256 of (prevHash || canonicalJson(payload)). 64 chars.
  hash      String   @db.VarChar(64)
  /// Hash of the previous event for the same tenant. Empty string for the
  /// first event in a tenant's chain.
  prevHash  String   @db.VarChar(64)
  createdAt DateTime @default(now())

  @@index([tenantId, seq])
  @@index([tenantId, type])
  @@index([tenantId, createdAt])
  @@index([resource])
}

/// Append-only event log for the durable execution engine.
///
/// This is the foundation for IMPLEMENTACION_NANORUN.md P1 #7
/// (event-sourced engine on Postgres, DBOS/Hatchet pattern). The
/// existing in-memory `ExecutionService.runWorkflow` mutates state
/// directly; that state is lost on a backend restart and a long
/// running runbook is dead. This table records every state
/// transition so a worker can:
///
///   1. Re-read the events for a given execution at startup
///   2. Reduce them to the current state (running, paused, completed)
///   3. Pick up from where the previous instance left off
///
/// Differences from `AuditEvent`:
///   - Scoped per execution (`executionId`), not per tenant
///   - NOT hash-chained — durability not tamper-evidence is the goal
///   - Mutable updates are allowed in principle but discouraged; the
///     append-only convention keeps replay deterministic
///   - Indexed for the read pattern "give me every event for this
///     execution in seq order" which is the hot path of the worker
model ExecutionEvent {
  /// Monotonically-increasing sequence per execution. The reducer
  /// walks events in seq order so the result is deterministic.
  seq         BigInt   @default(autoincrement())
  id          String   @id @default(uuid())
  executionId String
  /// Tenant copy stored alongside the event so worker queries can
  /// filter by tenant without joining Execution.
  tenantId    String
  /// Discriminator for the event variant. See ExecutionEventType in
  /// backend/src/runbook/engine/execution-event.types.ts for the
  /// closed union.
  type        String
  /// Optional node id the event is about (step.* events). Run-level
  /// events leave this null.
  nodeId      String?
  /// Structured payload — variant-specific shape, validated at the
  /// service boundary, stored as JSON for forward compatibility.
  payload     Json
  /// When the event was appended.
  createdAt   DateTime @default(now())

  @@index([executionId, seq])
  @@index([executionId, type])
  @@index([tenantId, createdAt])
}

/// Dedup ledger for inbound webhooks (Stripe, runbook webhooks, future
/// providers). (source, eventId) is UNIQUE — handlers try INSERT and
/// treat P2002 as "already processed, skip". tenantId is optional
/// because most provider event ids (evt_..., delivery UUIDs) are
/// globally unique; we keep the column so per-tenant retention sweeps
/// and cascade-on-tenant-delete work cleanly.
model WebhookEvent {
  id         String   @id @default(uuid())
  /// Provider discriminator — 'stripe', 'github', 'sentry', 'datadog',
  /// 'generic'. Combined with eventId to form the dedup key.
  source     String
  /// The provider's own unique event id (evt_..., delivery uuid,
  /// etc.). Stored as-is, no normalization — what the provider sends
  /// is what we compare against on the next delivery.
  eventId    String
  tenantId   String?
  receivedAt DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([source, eventId])
  @@index([receivedAt])
  @@index([tenantId, receivedAt])
}

/// Durable outbox for billing meter events.
///
/// The runtime (ExecutionService) writes a row here synchronously as
/// part of the run lifecycle; a background worker picks PENDING rows
/// up and ships them to Stripe (or the configured provider). A Stripe
/// outage lengthens nextAttemptAt rather than losing the event, which
/// closes the under-billing gap that fire-and-forget meter calls left.
///
/// Two layers of dedup against double-billing:
///   1. idempotencyKey is UNIQUE here — a runtime retry collapses to
///      one row via P2002.
///   2. Stripe's meter_events endpoint takes the same key — a worker
///      re-ship of an already-sent row collapses on Stripe's side.
model BillingEvent {
  id             String    @id @default(uuid())
  tenantId       String?
  /// Matches the BillableEventType union in billing-meter.types.ts
  /// ('run.started', 'run.completed', 'runner.minute', 'storage.gb_hour').
  /// Stored as plain TEXT so the union can evolve without an enum
  /// migration; the worker rejects unknown types explicitly.
  type           String
  /// Billing-side customer id (`cus_...` for Stripe). May be null for
  /// self-host or unconfigured-tenant rows — the worker skips those.
  customerId     String?
  value          Float
  idempotencyKey String    @unique
  metadata       Json?
  /// PENDING → worker hasn't shipped yet (or last attempt failed and
  /// the backoff window is still open).
  /// SENT → acknowledged by the provider; terminal.
  /// FAILED → exhausted max attempts; terminal, operator must inspect.
  status         String    @default("PENDING")
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now())
  lastError      String?
  createdAt      DateTime  @default(now())
  sentAt         DateTime?

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([tenantId, createdAt])
}

/// Key rotation state machine. One row per rotation run — tracks the
/// deadline the operator committed to, per-batch progress, and a
/// resumable cursor so a crashed rotation continues from the next
/// row on reboot instead of restarting at 0. createdByUserId is
/// SetNull so a GDPR purge doesn't erase the compliance trail.
model KeyRotationJob {
  id              String    @id @default(uuid())
  deadline        DateTime
  /// PENDING → not yet picked up (just-created or between ticks)
  /// RUNNING → worker is processing batches right now
  /// COMPLETED → every row was re-encrypted under the current key
  /// FAILED → row-level errors exhausted the retry budget; operator
  ///          must inspect before retrying
  /// CANCELLED → operator hit cancel
  status          String    @default("PENDING")
  /// When true, the worker counts rows but never writes. Used to
  /// estimate "how long is this going to take" before the operator
  /// commits to a real rotation.
  dryRun          Boolean   @default(false)
  rowsTotal       Int?
  rowsCompleted   Int       @default(0)
  rowsFailed      Int       @default(0)
  /// Opaque resume cursor. Shape: { table: 'ConnectedAccount' |
  /// 'User', lastId: string }. Worker persists after every batch so
  /// a crash/restart picks up where it left off.
  nextCursor      Json?
  lastError       String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  createdBy User? @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

/// Waitpoint token (trigger.dev parity).
///
/// Created by a step inside a run to PAUSE the run until something
/// external completes the token. Decouples "I need to pause" from
/// the resume protocol — the same token can be completed by a
/// Slack callback, a webhook, an SDK call, or another runbook,
/// all via `POST /api/waitpoints/:id/complete`.
///
/// `executionId` is nullable because a token can be created
/// without immediately attaching it to a paused run (advanced
/// pattern: pre-allocate the URL, hand it to a vendor, then create
/// a step that blocks on the same id).
enum WaitpointStatus {
  PENDING
  COMPLETED
  TIMED_OUT
  CANCELLED
}

model Waitpoint {
  id              String          @id
  tenantId        String
  /// The execution that's blocked on this token. Null when the
  /// token was minted without an active blocker (rare — used by
  /// "preflight" patterns where the URL is handed to a vendor
  /// before the step that waits on it runs).
  executionId     String?
  status          WaitpointStatus @default(PENDING)
  expiresAt       DateTime?
  tags            String[]        @default([])
  completedValue  Json?
  completedBy     String?
  completedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  execution Execution? @relation(fields: [executionId], references: [id], onDelete: SetNull)

  // The partial expiresAt index (PENDING tokens with a TTL) lives
  // in the migration SQL — Prisma's @@index lacks a `where` clause.
  @@index([expiresAt])
  @@index([tags], type: Gin, map: "Waitpoint_tags_idx")
  @@index([tenantId, status], map: "Waitpoint_tenant_status_idx")
}
