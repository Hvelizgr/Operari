generator client {
  provider = "prisma-client-js"
  previewFeatures = ["tracing"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         Role     @default(USER)
  tenantId     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  workflows  Workflow[]
  executions Execution[]

  @@index([tenantId])
  @@index([email])
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  plan      Plan     @default(FREE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  workflows Workflow[]
  storageBuckets StorageBucket[]

  @@index([slug])
}

model StorageBucket {
  id        String   @id @default(uuid())
  name      String
  data      Json     @default("{}")
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Workflow {
  id          String         @id @default(uuid())
  name        String
  description String?
  // DEPRECATED: These JSON fields are kept for backward compatibility during migration
  // They will be removed in a future version once all data is migrated
  nodes       Json?
  connections Json?
  isActive    Boolean        @default(false)
  schedule    String?
  userId      String
  tenantId    String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user              User                 @relation(fields: [userId], references: [id])
  tenant            Tenant               @relation(fields: [tenantId], references: [id])
  executions        Execution[]
  // New normalized relationships
  workflowNodes     WorkflowNode[]
  workflowConnections WorkflowConnection[]

  @@index([userId])
  @@index([tenantId])
  @@index([isActive])
}

// Normalized WorkflowNode model
model WorkflowNode {
  id         String   @id @default(uuid())
  workflowId String
  type       String
  title      String
  positionX  Float
  positionY  Float
  enabled    Boolean  @default(true)
  config     Json?    // Node-specific configuration (HTTP settings, email templates, etc.)
  inputs     Json?    // Array of input ports
  outputs    Json?    // Array of output ports
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  workflow            Workflow             @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  sourceConnections   WorkflowConnection[] @relation("SourceNode")
  targetConnections   WorkflowConnection[] @relation("TargetNode")

  @@index([workflowId])
  @@index([type])
}

// Normalized WorkflowConnection model
model WorkflowConnection {
  id           String   @id @default(uuid())
  workflowId   String
  sourceNodeId String
  sourcePort   Int?     // Index of the source port
  targetNodeId String
  targetPort   Int?     // Index of the target port
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workflow   Workflow     @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  sourceNode WorkflowNode @relation("SourceNode", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode WorkflowNode @relation("TargetNode", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([sourceNodeId])
  @@index([targetNodeId])
}

model Execution {
  id          String          @id @default(uuid())
  workflowId  String
  userId      String
  status      ExecutionStatus @default(PENDING)
  trigger     TriggerType
  startedAt   DateTime        @default(now())
  completedAt DateTime?
  duration    Int?
  error       String?
  pausedAt    DateTime?
  resumeState Json?
  metadata    Json?

  workflow        Workflow         @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id])
  nodeLogs        NodeLog[]
  executionErrors ExecutionError[]

  @@index([workflowId])
  @@index([userId])
  @@index([status])
  @@index([startedAt])
}

model NodeLog {
  id          String         @id @default(uuid())
  executionId String
  nodeId      String
  nodeName    String
  nodeType    String
  status      NodeLogStatus
  input       Json?
  output      Json?
  error       String?
  startedAt   DateTime       @default(now())
  completedAt DateTime?
  duration    Int?

  execution Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@index([nodeId])
  @@index([status])
}

model ExecutionError {
  id            String        @id @default(uuid())
  executionId   String
  nodeLogId     String?
  code          String
  message       String
  userMessage   String
  severity      ErrorSeverity
  isRetryable   Boolean       @default(false)
  retryCount    Int           @default(0)
  maxRetries    Int           @default(0)
  context       Json?
  stackTrace    String?
  cause         Json?
  createdAt     DateTime      @default(now())
  resolvedAt    DateTime?
  notifiedAt    DateTime?

  execution Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@index([code])
  @@index([severity])
  @@index([createdAt])
}

model ErrorNotificationConfig {
  id          String                   @id @default(uuid())
  tenantId    String
  name        String
  type        NotificationType
  webhookUrl  String?
  email       String?
  isActive    Boolean                  @default(true)
  minSeverity ErrorSeverity            @default(HIGH)
  errorCodes  String[]                 @default([])
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@index([tenantId])
  @@index([isActive])
}

model ScheduledJob {
  id         String   @id @default(uuid())
  workflowId String   @unique
  cronExpr   String
  isActive   Boolean  @default(true)
  lastRunAt  DateTime?
  nextRunAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive])
}

enum Role {
  ADMIN
  USER
  VIEWER
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum ExecutionStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
  PAUSED
}

enum NodeLogStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  SKIPPED
}

enum TriggerType {
  MANUAL
  SCHEDULED
  WEBHOOK
  API
}

enum ErrorSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NotificationType {
  WEBHOOK
  EMAIL
  SLACK
  TEAMS
}

model NodeType {
  id          String   @id @default(uuid())
  type        String   @unique  // e.g. "n8n-nodes-base.webhook"
  category    String   // e.g. "triggers"
  
  // Visuals
  icon        String   // Lucide icon name
  color       String   // Tailwind class or hex
  
  // I18n
  label       Json     // { "en": "Webhook", "es": "Webhook" }
  description Json?    // { "en": "...", "es": "..." }
  subtitle    Json?    // Extra info shown in search
  
  // Logic & Ports
  // e.g. [{ name: "main", type: "main", label: "Input" }, { name: "ai_tool", type: "ai_tool" }]
  inputs      Json?    @default("[]") 
  outputs     Json?    @default("[]")
  
  // Configuration UI Definition (Future proofing)
  // Defines fields: name, type (string/select), options, etc.
  properties  Json?    @default("[]")
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([type])
}
