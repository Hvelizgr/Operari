# NanoRun docker compose env
#
# Copy to `.env` next to docker-compose.yml and fill in. The compose
# file reads these via ${VAR_NAME:-default} so missing values fall
# back to dev placeholders that work locally but are NOT safe for any
# shared deployment.
#
#   cp .env.example .env
#   # edit .env
#   docker compose up -d

# Required: 32+ character random secret used to sign JWTs.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Required for Connected Accounts / SecretCipher / SecretReader.
# 32+ character hex string. Without this the connected-accounts
# feature crashes the first time anyone tries to read a credential.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Optional: enables the R4 RunbookAssistPanel diagnose endpoint.
# Without an AI key the panel still opens but the diagnose POST
# returns an error and the agent /api/chat surface is unusable.
ANTHROPIC_API_KEY=

# Optional: same surface, OpenAI provider.
# OPENAI_API_KEY=
# AI_MODEL_PROVIDER=openai
# AI_MODEL_NAME=gpt-4o-mini
