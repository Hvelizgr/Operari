# Operari / Operari — environment template.
#
# Copy this file to `.env` next to docker-compose.yml (dev) or
# docker-compose.prod.yml (prod) and fill in the required blocks.
# See docs/DEPLOYMENT.md for a step-by-step.
#
#   cp .env.example .env
#   # edit .env
#   docker compose up -d                        # dev
#   docker compose -f docker-compose.prod.yml up -d   # prod

# ---------------------------------------------------------------------
# REQUIRED — boot refuses to start without these in production
# ---------------------------------------------------------------------

# Domain name that resolves to the host (prod only). Caddy requests an
# ACME certificate for this exact name on first boot.
PUBLIC_DOMAIN=app.yourdomain.dev

# Let's Encrypt contact email. Used for expiration notices.
CADDY_EMAIL=you@yourdomain.dev

# Postgres credentials. Strong random password in prod.
POSTGRES_USER=operari
POSTGRES_PASSWORD=change-me-strong-random
POSTGRES_DB=operari

# 48+ hex bytes. Signs every JWT session token.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# 32+ hex bytes. Used for SecretCipher (connected accounts, MFA secrets).
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ---------------------------------------------------------------------
# Email delivery (password reset, invites, verification)
# ---------------------------------------------------------------------
# Without RESEND_API_KEY emails are logged to stdout instead of sent —
# fine for local dev, broken for anything user-facing in prod.
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@yourdomain.dev
CONTACT_FROM_EMAIL=noreply@yourdomain.dev

# ---------------------------------------------------------------------
# AI providers (optional — the AI assist drawer returns 500 without one)
# ---------------------------------------------------------------------
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# AI_MODEL_PROVIDER=anthropic
# AI_MODEL_NAME=claude-sonnet-4-6

# ---------------------------------------------------------------------
# OAuth social login (each provider is independently optional)
# ---------------------------------------------------------------------
# Create apps first:
#   Google: https://console.cloud.google.com/apis/credentials
#     Authorized redirect URI: https://{PUBLIC_DOMAIN}/api/auth/google/callback
#   GitHub: https://github.com/settings/developers → New OAuth App
#     Authorization callback URL: https://{PUBLIC_DOMAIN}/api/auth/github/callback
#
# The frontend hides each button unless NEXT_PUBLIC_OAUTH_* is "true".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
NEXT_PUBLIC_OAUTH_GOOGLE=false
NEXT_PUBLIC_OAUTH_GITHUB=false

# ---------------------------------------------------------------------
# Stripe billing (Checkout + Portal + webhook)
# ---------------------------------------------------------------------
# Without STRIPE_SECRET_KEY the billing routes return 501 and the
# pricing page falls back to a "contact us" waitlist. Wire these only
# after you have matching Product + Price IDs in the Stripe dashboard.
#
# Webhook endpoint to register in Stripe:
#   https://{PUBLIC_DOMAIN}/api/billing/webhook
# Events to subscribe:
#   checkout.session.completed
#   customer.subscription.created
#   customer.subscription.updated
#   customer.subscription.deleted
OPERARI_BILLING_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_YEARLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=

# ---------------------------------------------------------------------
# Plan quotas (override the per-tier defaults)
# ---------------------------------------------------------------------
# Set to 0 to mean "unlimited".
OPERARI_QUOTA_FREE_RUNBOOKS=3
OPERARI_QUOTA_FREE_RUNS=100
# OPERARI_QUOTA_TEAM_RUNBOOKS=0
# OPERARI_QUOTA_TEAM_RUNS=0

# ---------------------------------------------------------------------
# Password-breach check (HIBP k-anonymity)
# ---------------------------------------------------------------------
# Set to "false" if egress to api.pwnedpasswords.com is blocked.
# Threshold is the minimum occurrence count that counts as "breached".
OPERARI_PASSWORD_BREACH_CHECK=true
# OPERARI_PASSWORD_BREACH_THRESHOLD=1

# ---------------------------------------------------------------------
# Session cookie
# ---------------------------------------------------------------------
# Leave unset to auto-detect request protocol. Explicitly set to "true"
# when serving over HTTPS behind a TLS terminator that strips
# X-Forwarded-Proto. Prod compose defaults this to "true".
# COOKIE_SECURE=

# ---------------------------------------------------------------------
# Self-host knobs
# ---------------------------------------------------------------------
# Self-host single-tenant deployments can skip auth entirely. Must be
# "false" for any multi-tenant or networked deployment.
OPERARI_ANONYMOUS_MODE=false

# Runner backend. `local` = same container (fine for self-host);
# `docker` = spawn ephemeral containers (multi-tenant cloud);
# `fly` = Fly Machines / Firecracker microVM (cloud SaaS).
OPERARI_RUNNER=local
# FLY_API_TOKEN=
# FLY_APP_NAME=
# FLY_REGION=iad

# Custom plugins directory. Drop a directory of plugin packages there
# and the backend loads them at boot. See examples/plugins/hello-world
# for a working example.
# OPERARI_PLUGINS_DIR=/app/plugins

# ---------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------
# ENABLE_TRACING=true
# JAEGER_ENDPOINT=http://jaeger:14268/api/traces

# ---------------------------------------------------------------------
# Durable execution engine (ADR 0003)
# ---------------------------------------------------------------------
# OPERARI_DURABLE_ENGINE=true       # default in prod compose
# OPERARI_RESUME_WORKER_ACT=true    # set to "true" to let the resume worker mutate
